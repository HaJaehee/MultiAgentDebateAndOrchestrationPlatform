# ============================================================================
# 원격 접속 토큰 (app/security.py)
# 서버 PC(127.0.0.1)에서 접속할 때는 토큰 없이 바로 열립니다. 다른 PC에서 접속하려면 이 토큰으로
# 로그인해야 하며, 로그인 상태는 7일간 유지됩니다. 값이 비어 있거나 형식이 맞지 않으면 모든 원격 접속이 거부됩니다.
# 형식: 영문 대소문자·숫자 조합 정확히 24자. 서버 PC에서 MADO 화면 우측 상단의 열쇠 버튼으로
# 토큰을 새로 발급·저장하거나, 이 파일에서 수정한 값을 서버 재시작 없이 즉시 반영할 수 있습니다.
# 서버 PC에서 자신의 LAN 호스트명으로 접속해 루프백으로 연결되는 경우에만 MADO_ALLOWED_HOSTS에 해당 호스트명을 지정합니다.
# ============================================================================
MADO_ACCESS_TOKEN=
MADO_ALLOWED_HOSTS=

# ============================================================================
# 전역 LLM 설정 (conf.json의 llm 섹션에서 참조합니다)
# api_base 또는 api_key 중 하나만 설정되어 있어도 실제 LLM 호출을 시도하며,
# 둘 다 비어 있으면 오프라인 Mock 시뮬레이터로 동작합니다.
# ============================================================================
# LLM API URL (OpenAI 호환 엔드포인트)
#   사내 게이트웨이 : https://llm-gateway.mycorp.com/v1
#   vLLM / LM Studio: http://localhost:1234/v1
#   Ollama          : http://localhost:11434
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_API_VERSION=
LLM_PROVIDER=

# 에이전트별 개별 재정의 (비워 두면 위 전역 설정을 따릅니다)
ORCHESTRATOR_MODEL=
ORCHESTRATOR_API_BASE=
ARCHITECT_MODEL=
ARCHITECT_API_BASE=
CODER_MODEL=
CODER_API_BASE=
CRITIC_MODEL=
CRITIC_API_BASE=

# 상용 공급자(Provider) 직접 연결용 API 키 (선택)
#   여기에 키를 입력하는 것만으로는 자동 적용되지 않습니다. conf.json에서 해당 환경변수를 참조하는
#   에이전트에만 적용되며, 모델 이름도 해당 공급자 형식에 맞춰 지정해야 합니다 (아래 'Gemini 연동 안내' 참고).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# Gemini 연동 안내 (Google AI Studio 발급 API 키 기준)
#
# 1) 모든 에이전트에 Gemini를 사용할 때 — 위 '전역 LLM 설정'의 두 항목만 입력합니다.
#        LLM_MODEL=gemini/gemini-2.5-flash
#        LLM_API_KEY=<AI Studio에서 발급받은 키>
#    - 모델 이름 앞에는 반드시 gemini/ 접두사를 붙여야 합니다. 접두사를 생략하면 Vertex AI 경로로
#      요청되어 일반 API 키로는 인증에 실패하며, google/ 접두사는 지원하지 않습니다.
#    - 슬래시(/) 뒤에는 AI Studio 모델 목록의 모델 ID를 그대로 적습니다 (위 gemini-2.5-flash는 예시).
#    - LLM_API_BASE · LLM_PROVIDER · LLM_API_VERSION은 비워 둡니다. 주소를 입력하면 Google 서버 대신
#      해당 주소로 요청을 전송합니다.
#    - 에이전트별 *_MODEL 변수를 비워 두면 모두 전역 LLM_MODEL 설정을 따릅니다.
#    - OPENAI_API_KEY · ANTHROPIC_API_KEY에 값이 남아 있으면, conf.json에서 해당 변수를 직접 참조하는
#      에이전트는 LLM_API_KEY 대신 그 키를 사용합니다. 모든 에이전트를 Gemini로 통일하려면 비워 두십시오.
#
# 2) API 키를 GEMINI_API_KEY 한 곳에서만 관리할 때 — 변수 값에서 다른 변수를 참조할 수 있습니다.
#    참조하는 줄은 반드시 GEMINI_API_KEY 선언보다 아래에 작성해야 합니다 (위에 있으면 빈 값으로 처리됩니다).
#        GEMINI_API_KEY=<키>
#        LLM_API_KEY=${GEMINI_API_KEY}
#
# 3) 일부 에이전트에만 Gemini를 사용할 때 — conf.json에서 해당 에이전트의 api_key를 "${GEMINI_API_KEY}"로,
#    model을 "gemini/<모델 ID>"로 지정합니다. 기본 설정의 critic 에이전트는 이미 GEMINI_API_KEY를
#    참조하므로 GEMINI_API_KEY와 CRITIC_MODEL=gemini/<모델 ID>만 입력하면 됩니다.
#
# .env 파일은 서버 시작 시 한 번만 읽으므로, 수정한 뒤에는 MADO를 재시작해야 반영됩니다.
# 요금제에 따라 분당 요청 수 제한(RPM)이 적용됩니다. 여러 에이전트가 동시에 호출하여 429 오류가 발생하면
# 아래 '서버 기동 설정'의 APP_LLM_CONCURRENCY 값으로 동시 요청 수를 제한하십시오.
# ----------------------------------------------------------------------------

# ============================================================================
# 결정 LLM (System 1 — Jev / Laya)
# 에이전트의 System 1 결정 모델 옵션을 활성화했을 때(decision_llm.enabled = true) 참조합니다.
# API 키는 기본적으로 이 파일(.env)에서 관리하며, 에이전트별로 다른 키를 써야 할 때만 conf.json에서 재정의합니다.
# ============================================================================
# 공통 기본값 (비워 두면 backend=jev 및 각 백엔드의 기본 모델을 사용합니다)
DECISION_BACKEND=
DECISION_MODEL=
DECISION_API_BASE=
DECISION_API_KEY=

# Jev (TypeSafe AI — 기본 엔드포인트: https://api.typesafe.ai/v1)
JEV_API_KEY=
JEV_API_BASE=
JEV_MODEL=

# Laya (Convai Innovations — LAYA_API_BASE를 지정하면 HTTP 서버를 호출하고, 비워 두면 로컬 Python laya 패키지를 사용합니다)
LAYA_API_KEY=
LAYA_API_BASE=
LAYA_MODEL=
LAYA_MODEL_PATH=

# ============================================================================
# MCP 서버 실행 환경 (비워 두면 conf.json의 기본값을 사용합니다)
# 폐쇄망 배포 번들에서는 run_mado.bat / run_mado.ps1이 자동으로 채웁니다.
# ============================================================================
# 실행기 경로 (기본값: PATH에 등록된 node / python)
NODE_BIN=
PYTHON_BIN=
# MCP 서버 설치 경로
MCP_NODE_HOME=
MCP_SANDBOX_HOME=
# 에이전트 공용 작업 공간 경로
WORKSPACE_DIR=

# 코드 실행 샌드박스 (AirgappedPySandbox)
#   SANDBOX_KERNEL_PYTHON: pandas/numpy/matplotlib 등이 설치된 포터블 파이썬 경로입니다.
#   비워 두면 MADO 서버와 동일한 파이썬 인터프리터로 커널을 실행합니다.
SANDBOX_KERNEL_PYTHON=
SANDBOX_EXEC_TIMEOUT=60
SANDBOX_MAX_NAMESPACES=8

# 원격(HTTP) MCP 서버 — conf.json의 mcp_servers.remote_example에서 참조합니다.
#   서버 주소와 인증 토큰은 conf.json에 직접 적지 말고 이 파일에 설정하십시오. conf.json은 UI에서
#   설정을 변경할 때마다 다시 저장되고 배포 패키지에도 포함될 수 있지만, .env는 로컬에만 유지됩니다.
#   외부 네트워크로 연결하므로 폐쇄망 환경에서는 해당 서버를 활성화하지 마십시오.
REMOTE_MCP_URL=
REMOTE_MCP_TOKEN=

# AnythingLLM 사내/로컬 문서 검색(RAG) 연동 — conf.json의 mcp_servers.kb 설정에서 참조합니다.
#   API 키는 AnythingLLM 관리자 설정의 Developer API 메뉴에서 발급받습니다. URL을 비워 두면 http://localhost:3001 기본값이 적용됩니다.
#   작업 공간(Workspace)은 고유 슬러그(slug)로 지정합니다 (AnythingLLM 작업 공간 URL 끝부분의 고유 식별자).
ANYTHINGLLM_URL=
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=
ANYTHINGLLM_WORKSPACES=

# ============================================================================
# 서버 기동 설정 (conf.json의 app 섹션에서 참조합니다)
# 비워 두면 conf.json에 지정된 기본값을 사용합니다.
# ============================================================================
APP_HOST=
APP_PORT=
# 비워 두면 기본 SQLite(sqlite+aiosqlite:///./multiagent.db)를 사용합니다. PostgreSQL 전환 예: postgresql+asyncpg://사용자:비밀번호@호스트/DB
#   (상세 안내: docs/user_manual/03-core/07-persistence.md)
APP_DB_URL=
# LLM 서버에 동시에 전송할 최대 요청 수입니다 (비워 두거나 0이면 제한 없음).
#   conf.json의 app 섹션에 "llm_concurrency": "${APP_LLM_CONCURRENCY:-0}" 항목이 정의되어 있어야 반영됩니다
#   (conf.example.json에는 기본으로 포함되어 있습니다).
APP_LLM_CONCURRENCY=
