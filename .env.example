# ============================================================================
# 원격 접속 토큰 (app/security.py)
# 서버 PC(127.0.0.1)에서 여는 화면은 토큰 없이 들어옵니다. 다른 PC 에서 쓰려면 이 토큰으로
# 로그인해야 하고, 로그인은 7일 유지됩니다. 비어 있거나 형식이 틀리면 원격 접속은 전부 거부됩니다.
# 형식: 영문 대소문자·숫자 정확히 24자. 서버 PC 에서 MADO 를 열고 오른쪽 위 열쇠 버튼으로
# 새로 만들어 저장하거나, 여기 고친 값을 재기동 없이 적용할 수 있습니다.
# 서버 PC 에서 자기 LAN 이름으로 열어 루프백이 되는 경우만 MADO_ALLOWED_HOSTS 에 그 이름을 적습니다.
# ============================================================================
MADO_ACCESS_TOKEN=
MADO_ALLOWED_HOSTS=

# ============================================================================
# 전역 LLM 설정 ([llm] 섹션이 참조합니다)
# api_base 또는 api_key 중 하나만 있어도 실제 LLM 호출을 시도합니다.
# 둘 다 없으면 오프라인 Mock 시뮬레이터로 동작합니다.
# ============================================================================
# LLM API URL (OpenAI 호환 엔드포인트)
#   사내 게이트웨이 : https://llm-gateway.mycorp.com/v1
#   vLLM / LM Studio: http://localhost:1234/v1
#   Ollama          : http://localhost:11434
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_API_VERSION=
LLM_PROVIDER=

# 에이전트별 개별 오버라이드 (미설정 시 위 전역 값 사용)
ORCHESTRATOR_MODEL=
ORCHESTRATOR_API_BASE=
ARCHITECT_MODEL=
ARCHITECT_API_BASE=
CODER_MODEL=
CODER_API_BASE=
CRITIC_MODEL=
CRITIC_API_BASE=

# 상용 Provider 직결 시 사용하는 키 (선택)
#   키를 적어 두는 것만으로는 쓰이지 않습니다. conf.json 에서 그 변수를 가리키는 에이전트만
#   그 키를 쓰고, 모델 이름도 그 Provider 의 것이어야 합니다 (아래 'Gemini 로 돌리기' 참고).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# Gemini 로 돌리기 (Google AI Studio 에서 받은 API 키)
#
# 1) 모든 에이전트를 Gemini 로 — 위쪽 '전역 LLM 설정' 의 두 줄만 채웁니다.
#        LLM_MODEL=gemini/gemini-2.5-flash
#        LLM_API_KEY=<AI Studio 에서 받은 키>
#    - 모델 이름 앞에 반드시 gemini/ 를 붙입니다. 접두사 없이 쓰면 Vertex AI 로 가서 API 키로는
#      실패하고, google/ 로 시작하는 이름은 받지 않습니다.
#    - 뒤쪽 이름은 AI Studio 의 모델 목록에 나오는 것 그대로입니다 (위의 gemini-2.5-flash 는 예시).
#    - LLM_API_BASE · LLM_PROVIDER · LLM_API_VERSION 은 비워 둡니다. 주소를 적으면 구글이 아니라
#      그 주소로 보냅니다.
#    - 에이전트별 *_MODEL 을 비워 두면 모두 LLM_MODEL 을 따릅니다.
#    - OPENAI_API_KEY · ANTHROPIC_API_KEY 가 함께 채워져 있으면, conf.json 에서 그 키를 직접 가리키는
#      에이전트는 LLM_API_KEY 가 아니라 그 키를 씁니다. Gemini 로만 돌릴 때는 비워 두세요.
#
# 2) 키를 GEMINI_API_KEY 한 곳에만 두려면 — 값 안에서 다른 변수를 가리킬 수 있습니다.
#    가리키는 줄이 GEMINI_API_KEY 줄보다 아래에 있어야 합니다 (위에 있으면 빈 값이 됩니다).
#        GEMINI_API_KEY=<키>
#        LLM_API_KEY=${GEMINI_API_KEY}
#
# 3) 일부 에이전트만 Gemini 로 — conf.json 에서 그 에이전트의 api_key 를 "${GEMINI_API_KEY}" 로,
#    model 을 "gemini/<모델 이름>" 으로 둡니다. 기본 conf 의 critic 은 이미 GEMINI_API_KEY 를
#    가리키므로 GEMINI_API_KEY 와 CRITIC_MODEL=gemini/<모델 이름> 만 채우면 됩니다.
#
# .env 는 시작할 때 한 번 읽습니다. 고친 뒤에는 MADO 를 다시 띄우세요.
# 요금제에 따라 분당 요청 수 제한이 있습니다. 여러 에이전트가 함께 부르다 429 가 나면 아래
# '서버 기동 설정' 의 APP_LLM_CONCURRENCY 로 동시 요청 수를 줄입니다.
# ----------------------------------------------------------------------------

# ============================================================================
# MCP 서버 실행 환경 (미설정 시 conf.json 의 기본값 사용)
# 폐쇄망 번들에서는 run_mado.bat / run_mado.ps1 이 자동으로 채웁니다.
# ============================================================================
# 실행기 경로 (기본: PATH 의 node / python)
NODE_BIN=
PYTHON_BIN=
# MCP 서버 설치 위치
MCP_NODE_HOME=
MCP_SANDBOX_HOME=
# 에이전트 공용 작업 공간
WORKSPACE_DIR=

# 코드 실행 샌드박스 (AirgappedPySandbox)
#   SANDBOX_KERNEL_PYTHON: pandas/numpy/matplotlib 등이 설치된 포터블 파이썬 경로.
#   비우면 서버와 같은 인터프리터로 커널을 띄웁니다.
SANDBOX_KERNEL_PYTHON=
SANDBOX_EXEC_TIMEOUT=60
SANDBOX_MAX_NAMESPACES=8

# 원격(HTTP) MCP 서버 — conf.json 의 mcp_servers.remote_example 이 참조합니다.
#   주소와 토큰은 conf.json 에 직접 쓰지 말고 여기에 둡니다. 설정 파일은 화면에서
#   고칠 때마다 다시 쓰이고 배포판에도 함께 담기지만, .env 는 그렇지 않습니다.
#   바깥으로 나가는 연결이라 폐쇄망에서는 그 서버를 켜지 마세요.
REMOTE_MCP_URL=
REMOTE_MCP_TOKEN=

# AnythingLLM 문서 검색 — conf.json 의 mcp_servers.kb 가 참조합니다.
#   키는 AnythingLLM 설정의 Developer API 에서 만듭니다. 주소를 비우면 http://localhost:3001.
#   작업 공간은 slug 로 적습니다 (AnythingLLM 작업 공간 주소의 마지막 부분).
ANYTHINGLLM_URL=
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=
ANYTHINGLLM_WORKSPACES=

# ============================================================================
# 서버 기동 설정 (conf.json 의 app 이 이 값을 참조합니다)
# 비워두면 conf.json 에 적힌 기본값이 쓰입니다.
# ============================================================================
APP_HOST=
APP_PORT=
APP_DB_URL=
# LLM 에 동시에 보내는 요청의 상한 (비우거나 0 이면 제한 없음).
#   conf.json 의 app 에 "llm_concurrency": "${APP_LLM_CONCURRENCY:-0}" 항목이 있어야 쓰입니다
#   (conf.example.json 에는 들어 있습니다).
APP_LLM_CONCURRENCY=
