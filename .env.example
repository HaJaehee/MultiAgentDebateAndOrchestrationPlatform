# ============================================================================
# 원격 접속 토큰 (app/security.py)
# 서버 PC(127.0.0.1)에서 여는 화면은 토큰 없이 들어옵니다. 다른 PC 에서 쓰려면 이 토큰으로
# 로그인해야 하고, 로그인은 7일 유지됩니다. 비어 있거나 형식이 틀리면 원격 접속은 전부 거부됩니다.
# 형식: 영문 대소문자·숫자 정확히 24자. 서버 PC 에서 MADO 를 열고 오른쪽 위 열쇠 버튼으로
# 새로 만들어 저장하거나, 여기 고친 값을 재기동 없이 적용할 수 있습니다.
# 서버 PC 에서 자기 LAN 이름으로 열어 루프백이 되는 경우만 MADO_ALLOWED_HOSTS 에 그 이름을 적습니다.
# ============================================================================
MADO_ACCESS_TOKEN=
MADO_ALLOWED_HOSTS=

# ============================================================================
# 전역 LLM 설정 ([llm] 섹션이 참조합니다)
# api_base 또는 api_key 중 하나만 있어도 실제 LLM 호출을 시도합니다.
# 둘 다 없으면 오프라인 Mock 시뮬레이터로 동작합니다.
# ============================================================================
# LLM API URL (OpenAI 호환 엔드포인트)
#   사내 게이트웨이 : https://llm-gateway.mycorp.com/v1
#   vLLM / LM Studio: http://localhost:1234/v1
#   Ollama          : http://localhost:11434
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_API_VERSION=
LLM_PROVIDER=

# 에이전트별 개별 오버라이드 (미설정 시 위 전역 값 사용)
ORCHESTRATOR_MODEL=
ORCHESTRATOR_API_BASE=
ARCHITECT_MODEL=
ARCHITECT_API_BASE=
CODER_MODEL=
CODER_API_BASE=
CRITIC_MODEL=
CRITIC_API_BASE=

# 상용 Provider 직결 시 사용하는 키 (선택)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=

# ============================================================================
# MCP 서버 실행 환경 (미설정 시 conf.json 의 기본값 사용)
# 폐쇄망 번들에서는 run_mado.bat / run_mado.ps1 이 자동으로 채웁니다.
# ============================================================================
# 실행기 경로 (기본: PATH 의 node / python)
NODE_BIN=
PYTHON_BIN=
# MCP 서버 설치 위치
MCP_NODE_HOME=
MCP_SANDBOX_HOME=
# 에이전트 공용 작업 공간
WORKSPACE_DIR=

# 코드 실행 샌드박스 (AirgappedPySandbox)
#   SANDBOX_KERNEL_PYTHON: pandas/numpy/matplotlib 등이 설치된 포터블 파이썬 경로.
#   비우면 서버와 같은 인터프리터로 커널을 띄웁니다.
SANDBOX_KERNEL_PYTHON=
SANDBOX_EXEC_TIMEOUT=60
SANDBOX_MAX_NAMESPACES=8

# 원격(HTTP) MCP 서버 — conf.json 의 mcp_servers.remote_example 이 참조합니다.
#   주소와 토큰은 conf.json 에 직접 쓰지 말고 여기에 둡니다. 설정 파일은 화면에서
#   고칠 때마다 다시 쓰이고 배포판에도 함께 담기지만, .env 는 그렇지 않습니다.
#   바깥으로 나가는 연결이라 폐쇄망에서는 그 서버를 켜지 마세요.
REMOTE_MCP_URL=
REMOTE_MCP_TOKEN=

# ============================================================================
# 서버 기동 설정 (conf.json 의 app 이 이 값을 참조합니다)
# 비워두면 conf.json 에 적힌 기본값이 쓰입니다.
# ============================================================================
APP_HOST=
APP_PORT=
APP_DB_URL=
